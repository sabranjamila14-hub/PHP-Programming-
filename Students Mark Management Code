<?php
$marks = array(85, 72, 90, 65, 78);

$total = array_sum($marks);
$average = $total / count($marks);
$highest = max($marks);
$lowest = min($marks);

echo "Student Marks Management<br>";
echo "Marks: " . implode(", ", $marks) . "<br>";
echo "Total Marks: $total<br>";
echo "Average Marks: $average<br>";
echo "Highest Mark: $highest<br>";
echo "Lowest Mark: $lowest";
?>
